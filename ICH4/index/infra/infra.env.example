# ── GCP project config ────────────────────────────────────────────────────────
# These are read from cloudbuild.yaml automatically.
# Only override here if you need to target a different project for infra setup.
# GCP_PROJECT_ID=pharma-reguatory-author

# ── IAP OAuth credentials ─────────────────────────────────────────────────────
# Create at: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Application type: Web application
# Authorised redirect URI: https://iap.googleapis.com/v1/oauth/clientIds/{CLIENT_ID}:handleRedirect
IAP_DOMAIN=ich4.yourdomain.com
IAP_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
IAP_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# ── IAP audience ──────────────────────────────────────────────────────────────
# Populated automatically by setup_iap.py after it creates the load balancer.
# Format: /projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
# Copy the printed value here AND into config/.env after running setup_iap.py.
IAP_AUDIENCE=

# ── Demo access list ──────────────────────────────────────────────────────────
# Comma-separated Google email addresses to grant IAP access during setup.
# You can also add/remove individuals at any time with:
#   python infra/manage_access.py grant  someone@company.com
#   python infra/manage_access.py revoke someone@company.com
#   python infra/manage_access.py list
IAP_ALLOWED_EMAILS=you@gmail.com
